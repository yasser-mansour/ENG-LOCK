# Copy this to .env for local development (optional — defaults work fine without it).
# On Heroku, set these as Config Vars instead (Settings tab, or `heroku config:set`).

# Password for the ⚙️ screen-settings and 👁️ host-controls panels.
ADMIN_PASSWORD=itsme

# Code players must enter to join the lobby. Leave blank to allow anyone in with just a name.
DEFAULT_ACCESS_CODE=guess123
